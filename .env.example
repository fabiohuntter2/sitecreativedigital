# Copie para .env.local (desenvolvimento) ou cadastre nas variáveis da hospedagem.

# Endereço público do site (usado no SEO, sitemap e compartilhamento)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# ---- Acesso ao painel /admin ----
ADMIN_EMAIL=seu-email@exemplo.com
# Gere com: npm run hash-password -- "SuaSenhaForte"
ADMIN_PASSWORD_HASH=
# Segredo aleatório com 32+ caracteres (o comando acima também gera um)
AUTH_SECRET=

# ---- Supabase (banco de dados + armazenamento de arquivos) ----
# Painel do Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=
# Chave "service_role" (SECRETA — nunca exponha no navegador)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ---- Modo local (sem Supabase) ----
# LOCAL_DB_PATH=data/db.json
# LOCAL_UPLOAD_DIR=data/uploads
